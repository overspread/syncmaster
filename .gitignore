# Build output
build/
*.app
!SyncMaster.app/Contents/Info.plist
!SyncMaster.app/Contents/Resources/icon.icns

# SQLite database (contains local file paths + sync state)
*.sqlite
*.sqlite-*

# Runtime data
.syncmaster-*
.DS_Store

# Xcode
*.xcuserstate
*.swp
*~

# Python (legacy web backend)
__pycache__/
*.pyc

# ── Tauri / Rust ───────────────────────────────────────────────
# Cargo build artifacts
src-tauri/target/
target/

# Tauri CLI cache
src-tauri/gen/
!src-tauri/gen/schemas/

# Build-time copy of the webapp into src-tauri (generated by beforeDev/beforeBuildCommand)
src-tauri/webapp/

# Tauri bundled output (release .app/.exe/.AppImage live in here)
src-tauri/target/release/bundle/

# If you commit Cargo.lock for apps, remove this line
# src-tauri/Cargo.lock

# Keys / secrets
*.pem
*.key
.env
.env.*
